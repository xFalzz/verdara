# ============================================================================
# VERDARA — ENVIRONMENT CONFIGURATION (.env.example)
# Meta Global AI Developer Hackathon (Cerebral Valley)
# ============================================================================

# 1. Unified Meta Model API ($150 Free Hackathon Credits — dev.meta.ai)
# IMPORTANT: Set a Hard Spend Limit of $140.00 on dev.meta.ai Billing Page!
META_API_BASE_URL="https://api.meta.ai/v1"
META_API_KEY=""
META_MODEL_SPARK="muse-spark"
META_MODEL_SAM="sam-3-1"
META_MODEL_IMAGE="muse-image"
META_MODEL_VOICE="muse-voice-transcribe"
META_MODEL_OPEN="muse-spark-open"

# 2. 7-Layer AI Credit Shield & Priority Resident Reserve Pool ($35 Priority Reserve)
AI_DAILY_BUDGET_USD="12.00"
AI_LIFETIME_CAP_USD="135.00"
AI_JUDGE_RESERVE_USD="35.00"

# 3. Supabase (PostgreSQL 16 + PostGIS + Auth + Storage)
# Note: If left blank locally, Verdara automatically activates its Local Demo Store!
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# 4. Geospatial & OpenStreetMap Compliance (100% Free, 0 API Key Required)
OSM_USER_AGENT="Verdara/1.0 (https://github.com/xFalzz/verdara; resident@verdara.app)"
PHOTON_BASE_URL="https://photon.komoot.io"
OVERPASS_URLS="https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"
CRON_SECRET="verdara-resident-cleanup-secret-2026"
